          }
        }
      }
    },
    "lib-ui": {
      "projectType": "library",
      "root": "libs/lib-ui",
      "sourceRoot": "libs/lib-ui/src",
      "architect": {
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
