{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "apps",
  "projects": {
    "host": {
      "projectType": "application",
      "schematics": {},
      "root": "apps/host",
      "sourceRoot": "apps/host/src",
      "prefix": "app",
      "architect": {
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "host:esbuild:development",
            "tsConfig": "apps/host/tsconfig.spec.json"
          }
        },
        "esbuild": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/host/src/main.ts",
            "tsConfig": "apps/host/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/host/public"
              }
            ],
            "styles": ["apps/host/src/styles.css"],
            "outputPath": "dist/angular-github-actions",
            "polyfills": ["es-module-shims"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "apps/host/src/environments/environment.ts",
                  "with": "apps/host/src/environments/environment.production.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "apps/host/src/environments/environment.ts",
                  "with": "apps/host/src/environments/environment.dev.ts"
                }
              ],
              "outputPath": "dist/dev/host"
            },
            "cit": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "dev": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "apps/host/src/environments/environment.ts",
                  "with": "apps/host/src/environments/environment.dev.ts"
                }
              ]
            },
            "pages": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "apps/host/src/environments/environment.ts",
                  "with": "apps/host/src/environments/environment.production.ts"
                }
              ],
              "baseHref": "./"
            }
          },
          "defaultConfiguration": "production"
        },
        "build": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "cacheExternalArtifacts": true,
            "tsConfig": "apps/host/tsconfig.federation.json"
          },
          "configurations": {
            "production": {
              "target": "host:esbuild:production"
            },
            "development": {
              "target": "host:esbuild:development"
            },
            "cit": {
              "target": "host:esbuild:cit"
            },
            "dev": {
              "target": "host:esbuild:dev"
            },
            "pages": {
              "target": "host:esbuild:pages"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve-original": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "host:esbuild:production"
            },
            "development": {
              "buildTarget": "host:esbuild:development"
            },
            "cit": {
              "buildTarget": "host:esbuild:cit"
            },
            "dev": {
              "buildTarget": "host:esbuild:dev"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4200
          }
        },
        "serve": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "target": "host:serve-original:development",
            "tsConfig": "apps/host/tsconfig.federation.json",
            "rebuildDelay": 500,
            "cacheExternalArtifacts": true,
            "dev": true,
            "devServer": true,
            "port": 0
          }
        }
      }
    },
    "mfe1": {
      "projectType": "application",
      "schematics": {},
      "root": "apps/mfe1",
      "sourceRoot": "apps/mfe1/src",
      "prefix": "app",
