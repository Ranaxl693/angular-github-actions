    },
    "lib-core": {
      "projectType": "library",
      "root": "libs/lib-core",
      "sourceRoot": "libs/lib-core/src",
      "architect": {
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "host:esbuild:development",
