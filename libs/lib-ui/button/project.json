{
  "name": "ui-button",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "root": "libs/lib-ui/button",
  "sourceRoot": "libs/lib-ui/button/src",
  "projectType": "library",
  "tags": [
    "type:lib"
  ],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p libs/lib-ui/button/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"libs/lib-ui/button/src/**/*.{ts,html}\" --max-warnings=0"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ng test ui-button --watch=false"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ngc -p libs/lib-ui/button/tsconfig.lib.json"
      },
      "outputs": [
        "{workspaceRoot}/dist/libs/lib-ui/button"
      ]
    }
  }
}
